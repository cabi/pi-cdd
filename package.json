  "scripts": {
    "test": "node tests/smoke.mjs && node tests/tools.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@earendil-works/pi-tui": "^1.3.0",
    "jiti": "^2.7.0"
  }
}
